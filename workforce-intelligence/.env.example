# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=wfi
POSTGRES_PASSWORD=wfi_dev_password_change_me
POSTGRES_DB=workforce_intelligence
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://wfi:wfi_dev_password_change_me@db:5432/workforce_intelligence

# ─── Redis (optional) ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Backend API ──────────────────────────────────────────────────────────────
# Generate a strong value in production, e.g.: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-please-0000000000000000000000000000000000000000
JWT_ACCESS_TTL_MINUTES=60
# Comma-separated origins allowed to call the API (the dashboard).
CORS_ORIGINS=http://localhost:3000
API_ENV=development

# Retention (days / months as noted in SECURITY.md); used by cleanup jobs.
RETENTION_ACTIVITY_EVENTS_DAYS=180
RETENTION_CONTENT_VERSIONS_DAYS=90
RETENTION_AI_SUMMARIES_DAYS=365
RETENTION_ANALYTICS_DAYS=730

# ─── AI provider ────────────────────────────────────────────────────────────
# One of: mock | openai | anthropic | gemini
# Leave as "mock" (or unset any key) to run fully offline with deterministic
# placeholder AI output. No provider is hard-coded in the app.
AI_PROVIDER=mock
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── Dashboard ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
